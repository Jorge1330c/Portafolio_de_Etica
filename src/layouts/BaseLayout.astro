---
import '../styles/global.scss';
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import TopBar from '../components/TopBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MusicDock from '../components/MusicDock.astro';
import SeoMeta from '../components/SeoMeta.astro';
import { COURSE } from '../lib/portfolio';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
}

const {
  title,
  description = `Portafolio digital de identidad ética profesional — ${COURSE.name} (${COURSE.code}), ${COURSE.university}, ciclo ${COURSE.cycle}.`,
  crumbs
} = Astro.props;

const base = import.meta.env.BASE_URL;
const favicon = `${base.replace(/\/$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#080b16" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <SeoMeta title={title} description={description} />
    <ClientRouter />
    <script is:inline>
      try {
        const forced = new URLSearchParams(location.search).get('theme');
        const stored = forced || localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
        const fx = localStorage.getItem('effects');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        document.documentElement.setAttribute('data-effects', fx === 'on' || fx === 'off' ? fx : (reduce ? 'off' : 'on'));
      } catch (_e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido principal</a>
    
    <canvas class="starfield" data-starfield aria-hidden="true"></canvas>
    <div class="halo-layer" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="lantern" data-lantern aria-hidden="true"></div>
    <div class="reading-progress" aria-hidden="true"><span data-progress></span></div>

    <div class="app" data-app>
      <Sidebar />
      <div class="scrim" data-scrim aria-hidden="true"></div>
      <div id="main-wrapper">
        <TopBar crumbs={crumbs} />
        <div class="main-area">
          <main class="main-column" id="main">
            <slot />
          </main>
        </div>
        <SiteFooter />
      </div>
    </div>

    <MusicDock />

    <button class="back-to-top" type="button" data-back-to-top aria-label="Volver al inicio">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
    </button>

    <script>
      import { swapFunctions } from 'astro:transitions/client';
      import { initSidebarDrawer } from '../scripts/sidebar-drawer';
      import { initThemeToggle } from '../scripts/theme-toggle';
      import { initScrollReveal } from '../scripts/scroll-reveal';
      import { initBackToTop } from '../scripts/back-to-top';
      import { initStarfield } from '../scripts/starfield';
      import { initTilt } from '../scripts/tilt';
      import { initMusicDock } from '../scripts/music-dock';
      import { initReadingProgress, initCounters, initMagnetic, initLantern } from '../scripts/interactions';
      import { initEffectsToggle } from '../scripts/motion';

      document.addEventListener('astro:before-swap', (e) => {
        e.swap = () => {
          const html = document.documentElement;
          const theme = html.getAttribute('data-theme');
          const effects = html.getAttribute('data-effects');
          swapFunctions.deselectScripts(e.newDocument);
          swapFunctions.swapRootAttributes(e.newDocument);
          if (theme) html.setAttribute('data-theme', theme);
          if (effects) html.setAttribute('data-effects', effects);
          swapFunctions.swapHeadElements(e.newDocument);
          const restoreFocus = swapFunctions.saveFocus();
          const oldApp = document.querySelector('[data-app]');
          const newApp = e.newDocument.querySelector('[data-app]');
          if (oldApp && newApp) oldApp.replaceWith(newApp);
          restoreFocus();
        };
      });

      const init = () => {
        initThemeToggle(); initSidebarDrawer(); initScrollReveal(); initBackToTop();
        initStarfield(); initTilt(); initMusicDock(); initReadingProgress();
        initCounters(); initMagnetic(); initLantern(); initEffectsToggle();
      };
      document.addEventListener('astro:page-load', init);
      document.addEventListener('effects:change', init);
    </script>
  </body>
</html>
