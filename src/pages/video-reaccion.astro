---
import BaseLayout from '../layouts/BaseLayout.astro';
import References from '../components/References.astro';
import { withBase } from '../lib/paths';
import { COURSE } from '../lib/portfolio';

const base = import.meta.env.BASE_URL;

const analysis = [
  {
    label: 'Aspectos a examinar en las normas',
    text: 'Proponemos complementar los deberes generales con criterios operativos de accesibilidad, auditoría de decisiones, protección de datos y canales de atención alternativos.'
  },
  {
    label: 'Tensiones ético-legales',
    text: 'Cumplir una especificación no garantiza justicia si su diseño excluye a personas vulnerables. Debemos documentar y comunicar riesgos, distinguiendo obligación legal, norma social y deber moral.'
  },
  {
    label: 'Propuesta de humanización',
    text: 'Proponemos incluir pruebas con usuarios vulnerables, alternativas de atención, revisión humana y escalamiento de incidentes. Son propuestas, no artículos vigentes del código.'
  },
  {
    label: 'Reflexión sobre presión de decisión',
    text: 'Desde Weber, las buenas intenciones no eximen de responder por consecuencias previsibles. Desde Levinas, la persona afectada debe estar presente en el proceso de decisión.'
  }
];
---

<BaseLayout
  title={`Video-reacción crítico · ${COURSE.portfolioName}`}
  description="Video-reacción crítico al podcast: vacíos éticos, tensiones ético-legales y propuesta de humanización del código deontológico."
  crumbs={[{ label: 'Video-reacción' }]}
>
  <header class="page-header">
    <p class="page-header__eyebrow">Módulo III · Semanas 9–12</p>
    <h1 class="page-header__title">Video-reacción <span class="serif-em">crítico</span></h1>
    <p class="page-header__lead">
      A partir del propósito de AC1, la guía de revisión examina cómo las normas, los códigos deontológicos y la responsabilidad por consecuencias orientan la práctica profesional.
    </p>
  </header>

  <div class="video-layout reveal">
    <div class="video-frame-card">
      <div class="video-frame-card" style="aspect-ratio: 16/9; background: #000; display: flex; align-items: center; justify-content: center;">
        <video controls style="width: 100%; height: 100%; object-fit: contain;">
          <source src={`${base.replace(/\/$/, '')}/media/video_reaccion.mp4`} type="video/mp4">
          Tu navegador no soporta el elemento de video.
        </video>
      </div>
      <div class="video-meta">
        <p class="video-meta__title">Análisis y propuesta de humanización</p>
        <p class="video-meta__sub">Video-reacción · Duración: 9 min 13 s</p>
      </div>
    </div>

    <div class="analysis-list">
      {analysis.map((a) => (
        <div class="analysis-item">
          <p class="analysis-item__label">{a.label}</p>
          <p>{a.text}</p>
        </div>
      ))}
    </div>
  </div>
<section class="info-section prose"><h2>Fundamento de la revisión</h2><p>AC7 examina la confianza social necesaria para orientar decisiones; AC8 convierte el areté de AC1 en hábitos de transparencia, competencia y advertencia de riesgos; AC9, desde Weber, exige responder por las consecuencias previsibles. La luz del faro no basta si no comprobamos que las personas pueden llegar a puerto.</p><p>La síntesis de apoyo aplica las sesiones 9–11 al tema de vulnerabilidad de AC10. No se presenta como transcripción del video original.</p><p><a href={withBase(base,'bitacora/ac7-contrato-social')}>AC7 · Contrato social</a> · <a href={withBase(base,'bitacora/ac8-codigos-deontologicos')}>AC8 · Códigos deontológicos</a> · <a href={withBase(base,'bitacora/ac9-responsabilidad-profesional')}>AC9 · Responsabilidad</a></p><p>EC2: presentación grupal, 15–20 minutos, 18 % de la nota final. <a href={withBase(base,'bitacora/ec2-video-reaccion')}>Guía de sustentación.</a></p></section>
<References code="AC7"/><References code="AC8"/><References code="AC9"/>
</BaseLayout>
