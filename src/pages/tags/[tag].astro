---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { slugify, withBase } from '../../lib/paths';
import { COURSE } from '../../lib/portfolio';

export async function getStaticPaths() {
  const entries = await getCollection('bitacora');
  const map = new Map<string, { label: string; items: typeof entries }>();
  for (const e of entries) {
    for (const tag of e.data.tags ?? []) {
      const slug = slugify(tag);
      if (!slug) continue;
      const existing = map.get(slug);
      if (existing) existing.items.push(e);
      else map.set(slug, { label: tag, items: [e] });
    }
  }
  return Array.from(map.entries()).map(([slug, info]) => ({ params: { tag: slug }, props: { label: info.label, items: info.items } }));
}

const { label, items } = Astro.props;
const base = import.meta.env.BASE_URL;
const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`#${label} · ${COURSE.portfolioName}`} description={`Entradas etiquetadas con "${label}".`} crumbs={[{ label: 'Etiquetas', href: withBase(base, 'tags') }, { label }]}>
  <header class="page-header">
    <p class="page-header__eyebrow">Etiqueta</p>
    <h1 class="page-header__title">#{label}</h1>
    <p class="page-header__lead">{sorted.length} {sorted.length === 1 ? 'entrada' : 'entradas'} con esta etiqueta.</p>
  </header>

  <section id="post-list" class="reveal-stagger" data-tilt-group>
    {sorted.map((e, i) => (
      <PostCard href={withBase(base, `bitacora/${e.id}`)} title={e.data.title} excerpt={e.data.summary} date={e.data.date} topic={e.data.topic} number={e.data.number} surface={e.data.surface} cover={e.data.cover} pinned={i === 0} />
    ))}
  </section>
</BaseLayout>
