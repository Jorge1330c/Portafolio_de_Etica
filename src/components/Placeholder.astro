---
interface Props {
  title?: string;
  text?: string;
  meta?: string;
  icon?: 'compass' | 'mic' | 'video' | 'map' | 'audio' | 'image';
  tall?: boolean;
  class?: string;
}

const { title = 'En construcción', text, meta, icon = 'compass', tall = false, class: className = '' } = Astro.props;
---

<div class={`placeholder${tall ? ' placeholder--tall' : ''} ${className}`.trim()}>
  <span class="placeholder__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {icon === 'compass' && (<><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></>)}
      {icon === 'mic' && (<><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line></>)}
      {icon === 'audio' && (<><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></>)}
      {icon === 'video' && (<><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></>)}
      {icon === 'map' && (<><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></>)}
      {icon === 'image' && (<><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></>)}
    </svg>
  </span>
  <p class="placeholder__title">{title}</p>
  {text && <p class="placeholder__text">{text}</p>}
  {meta && <p class="placeholder__meta">{meta}</p>}
</div>
