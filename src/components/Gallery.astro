---
import Figure from './Figure.astro';
import type { ImageMetadata } from 'astro:assets';

interface Item {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
  credit?: string;
}

interface Props {
  items: Item[];
  heading?: string;
}

const { items, heading = 'Galería' } = Astro.props;
const count = items.length;
const layout = count === 1 ? 'solo' : count === 2 ? 'pair' : count === 3 ? 'trio' : 'grid';
---

{count > 0 && (
  <section class="gallery">
    <h2 class="gallery__heading">{heading}</h2>
    <div class={`gallery__grid gallery__grid--${layout}`}>
      {items.map((item, idx) => (
        <Figure src={item.src} alt={item.alt} caption={item.caption} credit={item.credit} loading="lazy" />
      ))}
    </div>
  </section>
)}
