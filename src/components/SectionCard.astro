---
import { withBase } from '../lib/paths';
import { STATUS_LABEL, isEnabled, type Section } from '../lib/portfolio';

interface Props { section: Section }
const { section: s } = Astro.props;
const base = import.meta.env.BASE_URL;
const enabled = isEnabled(s.status);
const Tag = enabled ? 'a' : 'div';
---

<Tag class:list={['section-card', { 'section-card--disabled': !enabled }]} href={enabled ? withBase(base, s.path) : undefined} data-tilt={enabled ? '' : undefined} aria-disabled={enabled ? undefined : 'true'}>
  <div class="section-card__top">
    <span class="section-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        {s.icon === 'users' && (<><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></>)}
        {s.icon === 'compass' && (<><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></>)}
        {s.icon === 'mic' && (<><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></>)}
        {s.icon === 'video' && (<><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></>)}
        {s.icon === 'map' && (<><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></>)}
      </svg>
    </span>
    <span class={`status status--${s.status}`}>{STATUS_LABEL[s.status]}</span>
  </div>
  <p class="section-card__eyebrow">{s.eyebrow}</p>
  <p class="section-card__title">{s.title}</p>
  <p class="section-card__desc">{s.desc}</p>
  {enabled ? (
    <span class="section-card__go">
      Abrir sección
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </span>
  ) : (
    <span class="section-card__go section-card__go--muted">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      Disponible más adelante
    </span>
  )}
</Tag>
